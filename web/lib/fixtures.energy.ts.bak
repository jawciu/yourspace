// Keyword routing for fallback mode. Ordered: more specific first.
export function pickFixture(personaId: string, message: string, prevKey?: string | null): string | null {
  const m = message.toLowerCase();
  const has = (...ws: string[]) => ws.some(w => m.includes(w));
  const k = (s: string) => (FIXTURES[`${personaId}:${s}`] ? `${personaId}:${s}` : null);
  const inFlow = (f: string) => !!prevKey?.startsWith(`${personaId}:${f}`);
  if (inFlow('meter') && has('blurry', 'photo', 'picture')) return k('meter:photo');
  if (inFlow('meter') && has('submitted', 'sent', 'done', 'here are')) return k('meter:done');
  if (inFlow('solar') && has('i rent', 'renting', 'we rent')) return k('solar:rent') ?? k('solar');
  if (inFlow('solar') && has('forget the battery', 'no battery', 'without the battery')) return k('solar:result');
  if (inFlow('solar') && has('battery')) return k('solar:battery');
  if (prevKey === `${personaId}:solar:roof` && has('photo', 'uploaded', 'shading', 'roof face', 'home in the day', 'most days', 'rarely', 'south', 'north', 'east', 'west', 'nothing', 'tree', 'chimney')) return k('solar:result') ?? k('solar:roof');
  if ((prevKey === `${personaId}:solar` || prevKey === `${personaId}:solar:owner`) && has('detached', 'semi', 'terrace', 'bungalow', 'flat')) return k('solar:roof') ?? k('solar');
  if (prevKey === `${personaId}:solar` && has('i own', 'we own', 'owner')) return k('solar:owner') ?? k('solar:roof') ?? k('solar');
  if (inFlow('solar:result') || inFlow('solar:battery')) return prevKey ?? null;
  if (inFlow('tariff') && has('will charge overnight', 'actually we will')) return k('tariff');
  if (inFlow('tariff') && has('day', 'not overnight', "don't charge", 'do not charge')) return k('tariff:daycharge');
  if (has('meter', 'reading')) return k('meter');
  if (has('solar', 'panel', 'roof')) return k('solar');
  if (has('tariff', 'cheaper', 'bill', 'deal', 'switch', 'save')) return k('tariff');
  return null;
}
