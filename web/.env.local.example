# Copy to .env.local.
# Without ANTHROPIC_API_KEY the app serves the hand-written plans in lib/fixtures.ts.
ANTHROPIC_API_KEY=sk-ant-...
# Renders and product images. Without it those blocks are skipped.
OPENAI_API_KEY=sk-...
# Optional. Default is claude-opus-5 at low effort. Production runs claude-sonnet-5.
# PLAN_MODEL=claude-sonnet-5
